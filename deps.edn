{;; target/classes holds the compiled Java bindings of mlx-c and llama.cpp
 ;; (clojure -T:build java), which only the MLX backend and the llama.cpp
 ;; engine load
 :paths ["src" "target/classes"]

 ;; Core policy (DESIGN.md §8): Clojure + the backend, nothing else.
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}}

 ;; as a git dependency, `clojure -X:deps prep` compiles the Java binding
 :deps/prep-lib {:alias :build :fn java :ensure "target/classes"}

 :aliases
 {;; clojure -X:test              every test
  ;; clojure -X:test:fast         without the ^:slow statistical tests
  ;; clojure -X:test:conformance  the backend conformance suite (array level);
  ;;                              with -J-Dgen.backend=mlx on another backend
  :test {:extra-paths ["test" "book/src"]
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn cognitect.test-runner.api/test}
  :fast {:exec-args {:excludes [:slow]}}
  ;; clojure -X:test:par, -X:test:fast:par …   the same in several JVMs
  ;;                              (gen.parallel; the JVM backend only)
  :par {:exec-fn gen.parallel/run}
  ;; also without the ^:heavy tests: scalar statistical tests that take
  ;; minutes on a lazy backend (every value read is an MLX evaluation)
  :light {:exec-args {:excludes [:slow :heavy]}}
  :conformance {:exec-args {:nses [gen.array-test gen.array-props-test gen.special-test gen.linalg-test
                                   gen.random-test gen.array.tape-test gen.array.batch-test gen.dist-test gen.reference-test]}}

  ;; clojure -M:bench …     (criterium; add :c2 to compare C2 against the Graal JIT;
  ;;                         test/ for the LLM benches, which measure the
  ;;                         Branching contract's statistic)
  :bench {:extra-paths ["bench" "test"]
          :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
          :extra-deps {criterium/criterium {:mvn/version "0.4.6"}}}

  ;; clojure -M:test:dev   a REPL with the test loop, (t) (dev/user.clj)
  :dev {:extra-paths ["dev"]
        :extra-deps {org.clojure/tools.namespace {:mvn/version "1.5.1"}}
        :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}

  ;; clojure -T:build java   compile the bindings (src-java) into target/classes
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}

  ;; Apache Commons Math's distributions (gen.dist.commons-math), outside
  ;; the core's dependencies: clojure -X:test:commons-math runs its tests too
  :commons-math {:extra-paths ["ext/commons-math/src" "ext/commons-math/test"]
                 :extra-deps {org.apache.commons/commons-math3 {:mvn/version "3.6.1"}}
                 :exec-args {:dirs ["test" "ext/commons-math/test"]}}

  ;; the MLX backend as the default (creation functions); the device is
  ;; -Dgen.mlx.device=cpu|gpu (default gpu when there is one)
  :mlx {:jvm-opts ["-Dgen.backend=mlx"]}

  ;; GraalVM 25 runs the Graal JIT by default; this alias switches to C2.
  :c2 {:jvm-opts ["-XX:-UseJVMCICompiler"]}}}
